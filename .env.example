# Copy this file to .env in the repository root. Do not commit .env.
# Use a unique password for PostgreSQL. Existing databases keep their current password until rotated.
POSTGRES_PASSWORD=

# Use at least 32 random UTF-8 bytes for JWT signing. Keep the same value across API restarts.
JWT_KEY=

# Required only if AdminSeed:OnStartup is enabled.
# AdminSeed__Password=
