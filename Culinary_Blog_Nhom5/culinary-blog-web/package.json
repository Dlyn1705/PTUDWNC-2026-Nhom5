{
  "name": "culinary-blog-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:image-ui": "node tests/image-processing-ui.cjs",
    "test:lab6-editor": "node tests/lab6-recipe-editor.e2e.cjs",
    "test:recipe-editor": "tsc -p tsconfig.recipe-editor-tests.json && node --test build/recipe-editor-tests/tests/recipe-editor.test.js",
    "test:security": "node --test tests/security.unit.cjs",
    "test:e2e:security": "npm run build && node tests/security.e2e.cjs",
    "test:logging": "tsc -p tsconfig.logging-tests.json && node --test build/logging-tests/tests/logging.test.js",
    "test:api": "tsc -p tsconfig.api-tests.json && node --test build/api-tests/tests/problemDetails.test.js build/api-tests/tests/recipeApiContract.test.js",
    "test:ui-store": "tsc -p tsconfig.ui-tests.json && node --test build/ui-tests/tests/ui-store.test.js",
    "test:common": "tsc -p tsconfig.common-tests.json && node --conditions=react-server --test build/common-tests/tests/common-components.test.js",
    "test:a11y": "node tests/accessibility.e2e.cjs",
    "test:e2e:states": "node tests/route-states.e2e.cjs",
    "test:auth": "tsc -p tsconfig.auth-tests.json && node --conditions=react-server --test --test-force-exit build/auth-tests/tests/*.test.js",
    "test:auth:e2e": "node tests/auth.e2e.mjs",
    "test:file-api": "tsc -p tsconfig.file-api-tests.json && node --test build/file-api-tests/tests/file-api.test.js",
    "test:e2e:file-api": "next build && node tests/file-api.e2e.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "redis": "^6.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
