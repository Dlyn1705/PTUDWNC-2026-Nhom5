# Server Components call this URL from the Next.js server.
# When running in Docker, use the API service URL, for example http://api:8080.
API_INTERNAL_URL=http://localhost:5156

# Browser requests use this public URL.
NEXT_PUBLIC_API_URL=http://localhost:5156

# Generate with: openssl rand -base64 32. Use a unique value per deployed environment.
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000

# Keep disabled to surface real API errors. Enable only for local UI development.
NEXT_PUBLIC_ENABLE_MOCKS=false
# Use the same Google OAuth client ID/secret as the backend.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-side URL used by the Auth.js Google callback.
API_INTERNAL_URL=http://localhost:5156
NEXT_PUBLIC_API_URL=http://localhost:5156

# Google Cloud Console authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
