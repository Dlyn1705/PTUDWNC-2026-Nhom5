# Server Components call this URL from the Next.js server.
# When running in Docker, use the API service URL, for example http://api:8080.
API_INTERNAL_URL=http://localhost:5156

# Browser requests use this public URL.
NEXT_PUBLIC_API_URL=http://localhost:5156

# Comma-separated public image origins allowed by CSP; use the deployed HTTPS MinIO/CDN origin in production.
CSP_IMAGE_ORIGINS=http://localhost:9000

# Generate with: openssl rand -base64 32. Use a unique value per deployed environment.
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000

# Shared, encrypted auth sessions and refresh coordination between Next.js instances.
# Use the same AUTH_SECRET on all instances. Use authenticated TLS Redis in production.
AUTH_REDIS_URL=redis://localhost:6379

# Keep disabled to surface real API errors. Enable only for local UI development.
NEXT_PUBLIC_ENABLE_MOCKS=false

# Public OAuth client ID used by Google Identity Services in the browser.
# Configure http://localhost:3000 as an authorized JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
