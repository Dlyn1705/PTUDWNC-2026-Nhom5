@CulinaryBlog.API_HostAddress = http://localhost:5156
@refreshToken = REPLACE_WITH_REFRESH_COOKIE_VALUE
@googleIdToken = REPLACE_WITH_GOOGLE_ID_TOKEN

GET {{CulinaryBlog.API_HostAddress}}/weatherforecast/
Accept: application/json

###

### Start Google OAuth Authorization Code Flow with PKCE
GET {{CulinaryBlog.API_HostAddress}}/api/v1/auth/google
Accept: text/html

### Exchange a Google ID token for the backend token pair
POST {{CulinaryBlog.API_HostAddress}}/api/v1/auth/google
Content-Type: application/json

{
	"idToken": "{{googleIdToken}}"
}

### Register and receive the refresh cookie
POST {{CulinaryBlog.API_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
	"email": "chef@example.com",
	"displayName": "Test Chef",
	"password": "SecurePass123!",
	"confirmPassword": "SecurePass123!"
}

### Login with email and password
POST {{CulinaryBlog.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
	"email": "chef@example.com",
	"password": "SecurePass123!"
}

### Rotate the refresh cookie returned by register or login
POST {{CulinaryBlog.API_HostAddress}}/api/v1/auth/refresh
Cookie: culinary_refresh_token={{refreshToken}}
