{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Observability": {
    "SlowRequestThresholdMs": 1000,
    "Seq": { "Enabled": false },
    "OpenTelemetry": {
      "Enabled": false,
      "UseConsoleExporter": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=culinary_blog_db;Username=postgres;Password=Password123!"
  },
  "Database": {
    "SeedOnStartup": false
  },
  "Jwt": {
    "Key": "CulinaryBlog_SuperSecretKey_For_Development_Must_Be_Long_Enough_2026",
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlogWeb",
    "AccessTokenDurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"]
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "AllowedHosts": "*"
}
