{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Observability": {
    "SlowRequestThresholdMs": 1000,
    "Seq": { "Enabled": false },
    "OpenTelemetry": {
      "Enabled": false,
      "UseConsoleExporter": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlogWeb",
    "AccessTokenDurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"]
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "SecurityMode": "StartTls",
    "FromAddress": "welcome@culinary.test",
    "FromName": "Culinary Blog",
    "PublicWebBaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 30,
    "LeaseSeconds": 180,
    "RetentionDays": 30
  },
  "AllowedHosts": "*"
}
