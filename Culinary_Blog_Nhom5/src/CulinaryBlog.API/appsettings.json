{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Observability": {
    "SlowRequestThresholdMs": 1000,
    "Seq": { "Enabled": false },
    "OpenTelemetry": {
      "Enabled": false,
      "UseConsoleExporter": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "SeedOnStartup": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlogWeb",
    "AccessTokenDurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "AllowedHosts": "*"
}
