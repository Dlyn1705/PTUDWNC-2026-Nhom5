[Unit]
Description=Culinary encrypted PostgreSQL and object backup
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=culinary-operations
WorkingDirectory=/srv/culinary
ExecStart=/usr/bin/pwsh -NoProfile -File /srv/culinary/infra/reliability/Backup-Stack.ps1 -Project culinary-production -EnvironmentFile /etc/culinary/reliability.env
TimeoutStartSec=2h
